# macOS
.DS_Store

# Secrets — NEVER commit
**/.env
**/.env.local
**/.env.*.local
**/keystore/
**/keystore.properties
**/*.jks
**/*.keystore
# Signing docs — they end up holding the store/key passwords
**/*KEYSTORE_INFO*.md
**/*SIGNING*.md
**/google-services.json
**/GoogleService-Info.plist
**/*service*account*.json
**/*credentials*.json

# Build outputs
**/build/
**/.gradle/
**/dist/
**/out/
**/*.aab
**/*.apk

# iOS
ios/**/xcuserdata/
ios/**/*.xcworkspace
ios/**/DerivedData/
ios/Pods/
ios/**/*.hmap
ios/**/*.ipa

# Node
**/node_modules/
**/.next/
**/.turbo/

# IDE
.vscode/
.idea/
*.iml
.kotlin/

# Store bundle output (release AAB)
android/store/*.aab

# Local
local.properties
*.log

# Working docs & QA artifacts (Koragan / Android bugfixing) — do not commit
context.md
handoff.md
IN-A-NUTSHELL.txt
android/context.md
android/handoff.md
android/env.sh
android/qa-screenshots/

# Store assets: keep the JPGs and the composed sets, not the bulk intermediates.
# photos/*.png are lossless masters (43 MB) — the JPGs are what the harness and the
# listing use. raw/ is 75 MB of unframed captures, regenerable via recapture.sh.
android/store/photos/*.png
android/store/screenshots/raw/
__pycache__/
.claude/
.vercel

# Editor/tool state, and the Supabase CLI's local scratch.
.cate/
supabase/.temp/
# A loose scratch file at the repo root that holds live credentials.
/file
